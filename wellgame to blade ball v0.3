-- Rainbow Effect Loop (Changes text colors smoothly)
task.spawn(function()
    while ScreenGui.Parent do
        local hue = tick() % 5 / 5
        local rainbowColor = Color3.fromHSV(hue, 1, 1)
        
        TitleLabel.TextColor3 = rainbowColor
        Button1.TextColor3 = rainbowColor
        Button2.TextColor3 = rainbowColor
        Button3.TextColor3 = rainbowColor
        
        task.wait()
    end
end)
